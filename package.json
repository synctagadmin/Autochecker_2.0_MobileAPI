    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:local": "node scripts/with-env.js local -- node dist/main",
        "start:staging": "node scripts/with-env.js staging -- node dist/main",
        "start:prod": "node scripts/with-env.js production -- node dist/main",
        "env:status": "node scripts/with-env.js local --status",
        "env:status:staging": "node scripts/with-env.js staging --status",
        "env:status:prod": "node scripts/with-env.js production --status",
        "env:validate": "node scripts/with-env.js local --validate",
        "env:validate:staging": "node scripts/with-env.js staging --validate",
        "env:validate:prod": "node scripts/with-env.js production --validate",
        "env:check": "node scripts/check-profiles.js",
        "typecheck": "tsc --noEmit -p tsconfig.build.json",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "migrate:texture-finish": "node scripts/migrations/2026-10-26-texture-finish.js"
    },
