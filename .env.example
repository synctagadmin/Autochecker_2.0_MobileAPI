# AutoChecker 2.0 MobileAPI - environment template.
# Copy to .env and fill in real values. NEVER commit the filled-in .env.
#
# On a deployed box this file lives at /var/www/autochecker/mobileapi/shared/.env and is
# symlinked into each release. Check what a profile resolves to before starting anything:
#
#   npm run env:status            (local)
#   npm run env:status:staging
#   npm run env:status:prod
#
# ── REQUIRED ──────────────────────────────────────────────────────────────────────────

# MongoDB. There is NO fallback: the app refuses to start without this, on purpose.
# It used to be hard-coded to the staging database, which meant a production deploy that
# forgot this would have come up silently writing to staging.
#
#   autocheckerpartsclone      the LIVE database
#   autocheckerpartsclonenew   the STAGING database
#
# The names read the opposite way round to most people's expectation. The profile for the
# environment you start declares which one it requires and refuses the other.
MONGO_URI=

# The key every MobileAPI token is signed and verified with. No fallback: the app
# refuses to start without it.
#
# This was a literal in src/auth/constants.ts in a PUBLIC repository, so the published
# value must be treated as compromised - set a new one here rather than copying it back.
# Changing it logs every signed-in app user out once, which is what changing it is for.
JWT_SECRET=

# The shared key the loader endpoints check before they will run. Also previously a
# literal in a public repository, which made the check decorative; treat the old value as
# compromised too.
LOADER_KEY=

# Scraper service (scraper-v2). Must end with a slash; a missing one is added.
#   production : https://scrapernew.autochecker.com/
#   local      : http://localhost:3050/
# The staging profile requires this explicitly - it has no default, because defaulting it
# to the production scraper would point staging traffic at the live one.
SCRAPER_URL=

# ── OPTIONAL ──────────────────────────────────────────────────────────────────────────

# HTTP port. Defaults to 3001, which is what this service has always listened on.
PORT=3001

# ── ERROR MONITORING (Sentry) ─────────────────────────────────────────────────────────
#
# Both are required together. With either missing the SDK is never initialised and
# nothing is sent - a developer machine stays silent unless it is asked not to.
#
# SENTRY_ENVIRONMENT is NOT set here: config/env.profiles.json sets it per profile, so
# a staging box cannot file its events as production. Setting it in this file would
# override that and is the one thing to avoid.
#
# The DSN is the backend project (`autochecker`), the same one AdminAPI, eBayAPI and
# the scraper report to - NOT the admin UI one. It is a credential: it belongs here, in
# shared/.env on the box, and nowhere in the repository.
SENTRY_DSN=

# Optional. Tracing is OFF unless this is set, deliberately: it is billed per span on a
# quota shared with four other services. 0.05 is a sane start once there is real volume
# to judge by. Anything unreadable or <= 0 means off; above 1 is capped.
SENTRY_TRACES_SAMPLE_RATE=

# Optional. Defaults to mobile-api@<package version>. The project is shared, so a bare
# version number in it would belong to any of the five services.
SENTRY_RELEASE=

# ── AZURE / FIREBASE ──────────────────────────────────────────────────────────────────
# Carried over from the legacy .env. Nothing in src/ reads any of these today: the Azure
# Blob settings come from the `settings` collection in MongoDB (setting.model.ts) and the
# FCM token is stored per user (users.model.ts). They are listed so the original shape is
# on record; leave them blank unless something starts reading them.

AADCLIENTID=
AADSECRET=
AADTENANTDOMAIN=
AADTENANTID=
SUBSCRIPTIONID=
RESOURCEGROUP=
ACCOUNTNAME=
ARMAADAUDIENCE=
ARMENDPOINT=
STORAGECONTAINERNAME=
BLOBURL=
STORAGEACCESSKEY=
FCMTOKEN=
