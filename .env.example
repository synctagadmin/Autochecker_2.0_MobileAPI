# AutoChecker 2.0 MobileAPI - environment template.
# Copy to .env and fill in real values. NEVER commit the filled-in .env.
#
# On a deployed box this file lives at /var/www/autochecker/mobileapi/shared/.env and is
# symlinked into each release. Check what a profile resolves to before starting anything:
#
#   npm run env:status            (local)
#   npm run env:status:staging
#   npm run env:status:prod
#
# ── REQUIRED ──────────────────────────────────────────────────────────────────────────

# MongoDB. There is NO fallback: the app refuses to start without this, on purpose.
# It used to be hard-coded to the staging database, which meant a production deploy that
# forgot this would have come up silently writing to staging.
#
#   autocheckerpartsclone      the LIVE database
#   autocheckerpartsclonenew   the STAGING database
#
# The names read the opposite way round to most people's expectation. The profile for the
# environment you start declares which one it requires and refuses the other.
MONGO_URI=

# Scraper service (scraper-v2). Must end with a slash; a missing one is added.
#   production : https://scrapernew.autochecker.com/
#   local      : http://localhost:3050/
# The staging profile requires this explicitly - it has no default, because defaulting it
# to the production scraper would point staging traffic at the live one.
SCRAPER_URL=

# ── OPTIONAL ──────────────────────────────────────────────────────────────────────────

# HTTP port. Defaults to 3001, which is what this service has always listened on.
PORT=3001

# ── AZURE / FIREBASE ──────────────────────────────────────────────────────────────────
# Carried over from the legacy .env. Nothing in src/ reads any of these today: the Azure
# Blob settings come from the `settings` collection in MongoDB (setting.model.ts) and the
# FCM token is stored per user (users.model.ts). They are listed so the original shape is
# on record; leave them blank unless something starts reading them.

AADCLIENTID=
AADSECRET=
AADTENANTDOMAIN=
AADTENANTID=
SUBSCRIPTIONID=
RESOURCEGROUP=
ACCOUNTNAME=
ARMAADAUDIENCE=
ARMENDPOINT=
STORAGECONTAINERNAME=
BLOBURL=
STORAGEACCESSKEY=
FCMTOKEN=
