# AutoChecker 2.0 MobileAPI - environment template.
# Copy to .env and fill in real values. NEVER commit the filled-in .env.
# Values are held outside the repository; ask the infrastructure owner.

# Azure AD (service principal)
AADCLIENTID=
AADSECRET=
AADTENANTDOMAIN=
AADTENANTID=

# Azure subscription / resource targets
SUBSCRIPTIONID=
RESOURCEGROUP=
ACCOUNTNAME=
ARMAADAUDIENCE=
ARMENDPOINT=

# Azure Blob Storage
STORAGECONTAINERNAME=
BLOBURL=
STORAGEACCESSKEY=

# Firebase Cloud Messaging (push notifications)
FCMTOKEN=
